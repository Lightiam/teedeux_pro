# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed vars
# to the browser bundle.

# ---------------------------------------------------------------------------
# API location
# ---------------------------------------------------------------------------
# Where the client sends API requests.
#
# Leave unset in development: vite.config.ts proxies /api to the server, so
# relative URLs work and there is no CORS preflight. The same is true on
# Netlify (via the redirect) and on Firebase Hosting (via the rewrite).
#
# Set it only when the client must call the API cross-origin directly — for
# example the Capacitor build, which is not served from the API's origin.
# VITE_API_URL="https://api.example.com"

# Where `npm run dev` proxies /api. Defaults to http://localhost:4000.
# API_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Firebase (optional)
# ---------------------------------------------------------------------------
# Set these to use Firebase Authentication. Leave them unset and the app signs
# in against the Express backend in server/ instead — the choice is detected
# from whether these are present, so there is no mode flag to keep in sync.
#
# These values are PUBLIC. They ship inside the JavaScript bundle and identify
# the project; they do not grant access to it. Access is controlled by the
# Firestore security rules and by Firebase Auth.
#
# NEVER put a service account key here. That file grants full admin access and
# bypasses every security rule. It belongs outside the repo and is referenced
# by path via GOOGLE_APPLICATION_CREDENTIALS, only for the seed script.
#
# Find these at: Firebase Console -> Project settings -> General ->
#                Your apps -> Web app -> SDK setup and configuration
#
# VITE_FIREBASE_API_KEY="AIza..."
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project"
# VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
# VITE_FIREBASE_APP_ID="1:000000000000:web:abc123"
