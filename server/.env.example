# Copy to .env and adjust as needed. All values below are the defaults.

PORT=4000

# Required when NODE_ENV=production; a dev fallback is used otherwise.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite file path, or ":memory:" for an ephemeral database.
DATABASE_URL=data/teedeux.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:4300
